{"pages":[{"w":612,"ocr":false,"h":792,"segs":[["G O I N G O N A U. S. S U M M E R P ROJ EC T 1",43.841199999999994,509.49989999999997,57.071200000000005,659.44129999999996,9,false],["GOING ON A U.S.",151.90000000000001,33.840599999999995,437.98000000000002,116.00059999999996,80,false],["SUMMER PROJECT",151.90000000000001,93.840599999999995,490.86000000000001,176.00059999999996,80,false],["Summer Project offers the opportunity for you to take",146.40000000000001,250.64469999999983,347.49599999999998,263.04669999999987,9,false],["the good news of forgiveness in Jesus to virtually",146.40000000000001,263.64069999999981,329.22600000000011,276.04269999999985,9,false],["anywhere in the world with Campus Crusade for",146.40000000000001,276.63669999999991,328.14600000000007,289.03869999999989,9,false],["Christ so ultimately everyone will know someone who",146.40000000000001,289.63269999999989,349.14300000000009,302.03469999999987,9,false],["truly follows Jesus!",146.40000000000001,302.62869999999987,219.44400000000002,315.03069999999985,9,false],["grow in confidence as you go out and talk to people",370.20299999999997,250.53669999999954,558.62700000000018,262.93869999999959,9,false],["in the community you are in, people at work, and as",370.20299999999997,263.53269999999952,561.30000000000007,275.93469999999957,9,false],["you see others on project share and learn from them.",370.20299999999997,276.52869999999962,566.14200000000005,288.9306999999996,9,false],["Remember, you will not be growing alone, but you will",370.20299999999997,289.5246999999996,571.73099999999999,301.92669999999958,9,false],["be taking steps of faith in a community of others like",370.20299999999997,302.52069999999958,565.57500000000005,314.92269999999957,9,false],["you!",370.20299999999997,315.51669999999956,386.35799999999995,327.91869999999955,9,false],["Anywhere you go will involve taking steps of faith –",146.40000000000001,328.62969999999984,337.81200000000013,341.03169999999983,9,false],["follo