{"pages":[{"ocr":false,"w":612,"h":792,"segs":[["anything 1,200 pages",97.276499999999999,37.350499999999897,514.7269,117.08049999999992,70,false],["is inspired",198.22800000000001,100.3504999999999,413.779,180.08049999999992,70,false],["We get together, look at a book or passage of the",52.840000000000003,442.1302,308.9049,458.79509999999999,13.300000000000001,false],["New Testament, then try to hash it out— make",52.840000000000003,465.1302,296.11029999999994,481.79509999999999,13.300000000000001,false],["sense of what it all means. We discuss, debate,",52.840000000000003,488.1302,292.1735000000001,504.79509999999999,13.300000000000001,false],["agree, disagree: but always find a way to apply it",52.840000000000003,511.1302,299.74120000000011,527.79510000000005,13.300000000000001,false],["personally. No requirements, but no cynics: we’re",52.840000000000003,534.13020000000006,306.6173,550.79510000000005,13.300000000000001,false],["serious about pursuing a stronger more authentic",52.840000000000003,557.13020000000006,311.2989,573.79510000000005,13.300000000000001,false],["faith—and you’re invited.",52.840000000000003,580.13020000000006,182.3554,596.79510000000005,13.300000000000001,false],["groUps",198.12,627.92399999999998,248.2955,647.97199999999998,16,false]]}]}