{"pages":[{"segs":[["BUILDING A MOVEMENT:",151.90000000000001,33.894599999999969,571.38400000000001,114.00059999999996,78,false],["ANOTHER OUTREACH",151.90000000000001,92.862599999999929,515.53600000000006,172.96859999999992,78,false],["STEP 20",152.00960000000001,165.19659999999988,220.0496,191.51659999999993,20,false],["MID TO LATE FEBRUARY",145.40000000000001,227.04970000000003,224.48000000000002,242.4547,15,false],["There are times during the school year where you",145.40000000000001,242.5696999999999,330.28700000000003,254.97169999999994,9,false],["want evangelism in the form of some major outreach",145.40000000000001,255.56569999999988,342.26600000000008,267.96769999999992,9,false],["or initiative to take center stage in the ministry and",145.40000000000001,268.56169999999997,337.18100000000015,280.96369999999996,9,false],["February is another one of those times.",145.40000000000001,281.55769999999995,291.15499999999997,293.95969999999994,9,false],["As students return for second semester you need",145.40000000000001,307.55869999999993,327.91100000000006,319.96069999999992,9,false],["to devote several weeks to getting your community",145.40000000000001,320.55469999999991,334.85000000000002,332.9566999999999,9,false],["functioning like a community again. But times of",145.40000000000001,333.55069999999989,327.73100000000011,345.95269999999988,9,false],["building up should always be followed by times of",145.40000000000001,346.54669999999987,329.88200000000018,358.94869999999986,9,false],["reaching out. And so at some point in February you",145.40000000000001,359.54269999999985,335.31800000000004,371.94469999999984,9,false],["want to be thinking in terms of a major ministry focus",145.40000000000001,372.53869999999984,346.47800000000018,384.94069999999982,9,false],["on evangelism.",145.40000000000001,385.53469999999982,201.29900000000004,397.9366999999998,9,false],["You’ll find all manner of ideas and options in the",145.40000000000001,411.53569999999979,325.00400000000002,423.93769999999978,9,false],["Evangelism section entitled “Outreach.”",145.40000000000001,424.53169999999977,295.83499999999992,436.93369999999976,9,false],["B U I L D I N G M OV E M E N TS 1",43.841200000000001,509.49989999999997,57.071200000000005,606.57799999999997,9,false],["© 2010, CruPress, All Rights Reserved. CruPress.com",204.23800660000001,766.03521969999997,407.76200660000006,778.43721970000001,9,false]],"h":792,"ocr":false,"w":612}]}