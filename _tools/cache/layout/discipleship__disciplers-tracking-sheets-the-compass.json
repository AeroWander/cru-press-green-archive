{"pages":[{"w":612,"segs":[["T H E CO M PA S S 1",43.841200000000001,509.49989999999997,57.071200000000005,569.69539999999995,9,false],["P OS TC A R DS F RO M CO R I N T H 1",43.841199999999994,509.49989999999997,57.071200000000005,630.99379999999996,9,false],["DISCIPLER’S TRACKING SHEETS",336.87819999999999,171.94540000000006,581.00319999999999,195.25540000000001,21,false],["THE COMPASS",308.90000000000003,218.46109999999999,373.12,239.00109999999995,20,false],["The Compass delivers an easy-to-follow discipleship curriculum,",308.90000000000003,238.07609999999988,555.86000000000013,250.47809999999993,9,false],["providing lesson plans on core biblical messages as well as basic",308.90000000000003,251.07609999999988,550.65800000000002,263.47809999999993,9,false],["ministry skills. You could look at The Compass as basic Follow-up",308.90000000000003,264.07609999999988,557.93000000000006,276.47809999999993,9,false],["appointments, 6-50.",308.90000000000003,277.0761,385.24700000000007,289.47809999999998,9,false],["The CD contains over 40 lessons to help prepare you for weekly",308.90000000000003,303.0761,548.59700000000009,315.47809999999998,9,false],["appointments with your disciples. The curriculum is organized into",308.90000000000003,316.0761,564.72500000000014,328.47809999999998,9,false],["3 levels: Walk by Faith, Communicate Your Faith, and Multiply Your",308.90000000000003,329.0761,566.01200000000017,341.47809999999998,9,false],["Faith.",308.90000000000003,342.0761,331.16600000000005,354.47809999999998,9,false],["Topics Include: Community, Prayer, Position in Christ, Assurance",308.90000000000003,368.0761,558.25400000000025,380.47809999999998,9,false],["of Salvation, Sharing the Gospel, Filling of the Spirit, Confession,",308.90000000000003,381.0761,554.98700000000019,393.47809999999998,9,false],["Obedience, Sanctification, Eternal Perspective, Justification by Faith,",308.90000000000003,394.0761,572.89700000000016,406.47809999999998,9,false],["Spiritual Multiplication, How to Share the Ministry of the H.S., How",308.90000000000003,407.0761,567.74000000000001,419.47809999999998,9,false],["to Conduct Basic Follow-up, God’s Will, Scripture Memory, Time",308.90000000000003,420.0761,555.19400000000007,432.47809999999998,9,false],["Management, and Sharing Your Testimony. We’ve also included a",308.90000000000003,433.0761,555.99500000000012,445.47809999999998,9,false],["number of additional resources. Not the least of which is a series of",308.90000000000003,446.0761,562.03400000000011,458.47809999999998,9,false],["talks by Roger Hershey on discipleship.",308.90000000000003,459.0761,457.73300000000006,471.47809999999998,9,false],["ORDER ONLINE AT CRUPRESS.COM",306.90000000000003,701.601,528.6400000000001,723.00099999999998,20,false]],"ocr":false,"h":792},{"segs":[["Walk by Faith",66.5852,58.579899999999952,144.93819999999999,71.317900000000009,11,true],["Assurance of Salvation",66.5852,71.746900000000096,168.02719999999999,84.473900000000071,11,false],["Position in Christ",66.5852,84.946900000000142,144.93819999999999,97.673900000000117,11,false],["The Spirit-Filled Life",66.5852,98.146900000000187,157.34620000000001,110.87390000000016,11,false],["Fellowship",66.5852,111.34690000000023,113.75320000000001,124.07390000000021,11,false],["The Word",66.5852,124.54690000000028,114.0612,137.27390000000025,11,false],["Prayer",66.5852,137.74690000000032,95.746200000000002,150.4739000000003,11,false],["Sharing the Gospel",66.5852,150.94690000000037,151.97820000000002,163.67390000000034,11,false],["Justification by Faith",66.5852,177.34690000000035,156.81819999999999,190.07390000000032,11,false],["Confession",66.5852,190.54690000000039,116.7782,203.27390000000037,11,false],["Growth",66.5852,203.74690000000044,102.56620000000001,216.47390000000041,11,false],["The Importance of Church",66.5852,216.94690000000048,187.7722,229.67390000000046,11,false],["Obedience",66.5852,230.14690000000053,115.76620000000003,242.8739000000005,11,false],["Etern