99999996,278.1638999999999,211.98660000000001,288.61289999999991,9,false],["Easter eggs containing invitations to the trial",37.143599999999999,288.66689999999988,206.55959999999999,299.1158999999999,9,false],["of Jesus. Close to 150 students watched the",37.008600000000001,299.16989999999987,205.11060000000003,309.61889999999988,9,false],["drama.",36.927599999999998,309.67289999999986,63.684600000000003,320.12189999999987,9,false],["211›› \u0007 Recliners In the",35.939100000000003,309.34899999999999,165.21678,360.30399999999997,37.625,false],["Middle of Campus",94.943600000000004,337.46799999999996,178.12502000000001,348.30399999999997,8.9100000000000001,false],["Students at the University of Kansas set up",36.705600000000004,348.35499999999996,199.68660000000006,358.80399999999997,9,false],["recliners and chairs in the middle of",37.110600000000005,358.85799999999995,172.86660000000006,369.30699999999996,9,false],["campus (free speech area) to",37.002600000000008,369.36099999999993,147.26160000000004,379.80999999999995,9,false],["invite their peers to watch the",37.200600000000009,379.86399999999992,151.44660000000005,390.31299999999993,9,false],["JESUS film.",36.507600000000011,390.3669999999999,78.276600000000002,400.81599999999992,9,false],["( 79 )",214.27090000000001,618.96010000000001,235.92080000000001,630.95010000000002,10,false],["© 2010, CruPress, All Rights Reserved. CruPress.com",120.9309998,620.7502197,347.06899980000003,634.53021969999998,10,false]],"w":468}]}