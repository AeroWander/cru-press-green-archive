{"pages":[{"segs":[["it’s beyond you",152.28489999999999,80.504799999999932,459.71770000000004,162.51279999999997,72,false],["We get together, look at a book or passage of the",52.840000000000003,438.22199999999998,303.1277,454.51099999999997,13,false],["New Testament, then try to hash it out— make",52.840000000000003,460.22199999999998,290.62299999999993,476.51099999999997,13,false],["sense of what it all means. We discuss, debate, agree,",52.840000000000003,482.22199999999998,320.22400000000005,498.51099999999997,13,false],["disagree: but always find a way to apply it personally.",52.840000000000003,504.22199999999998,317.32240000000013,520.51099999999997,13,false],["No requirements, but no cynics: we’re serious about",52.840000000000003,526.22199999999998,316.36430000000007,542.51099999999997,13,false],["pursuing a stronger more authentic faith—and",52.840000000000003,548.22199999999998,289.69999999999999,564.51099999999997,13,false],["you’re invited.",52.840000000000003,570.22199999999998,123.13100000000001,586.51099999999997,13,false],["groUps",198.12,617.92399999999998,248.2955,637.97199999999998,16,false]],"h":792,"ocr":false,"w":612}]}